        "id": "packages/pipeline/session_store.py::_store_path",
        "loc": "packages/pipeline/session_store.py:17-29",
        "text": "def _store_path(repo: Path, session_id: str | None = None) -> Path:\n    from pipeline.session_isolation import effective_session_id, session_data_dir\n\n    repo_p = Path(repo).resolve()\n    sid = effective_session_id(session_id)\n    if sid:\n        return session_data_dir(repo_p, sid) / \"session_store.json\"\n    from pipeline.project_id import repo_runtime_dir\n\n    base = repo_runtime_dir(repo_p)\n    base.mkdir(parents=True, exist_ok=True)\n    name = os.environ.get(\"CTX_SESSION_STORE\") or \"session_store.json\"\n    return base / name"
      },
      {
        "id": "packages/pipeline/project_id.py::repo_runtime_dir",
        "loc": "packages/pipeline/project_id.py:121-142",
        "text": "def repo_runtime_dir(root: Path) -> Path:\n    \"\"\"Writable per-repo runtime dir (enrollment vs MCP scratch).\n\n    Enrolled checkouts use ``<repo>/.scubiee``. Unenrolled repos (including\n    immediately after ``wipe``) must not recreate ``.scubiee`` \u2014 MCP session\n    state goes under ``~/.scubiee/scratch/<key>/`` or a temp dir when home is\n    gone.\n    \"\"\"\n    root = root.resolve()\n    try:\n        from pipeline.mcp_locate import _is_enrolled\n\n        if _is_enrolled(root):\n            return id_dir_path(root)\n    except Exception:  # noqa: BLE001\n        pass\n    home = context_engine_home()\n    if home.is_dir():\n        return home / \"scratch\" / legacy_repo_key(root)\n    import tempfile\n\n    return Path(tempfile.gettempdir()) / \"scubiee-scratch\" / legacy_repo_key(root)"
      },
      {
        "id": "packages/pipeline/session_isolation.py::effective_session_id",
        "loc": "packages/pipeline/session_isolation.py:368-375",
        "text": "def effective_session_id(explicit: str | None = None) -> str | None:\n    info = resolve_session(explicit)\n    sid = str(info.get(\"session_id\") or \"\").strip()\n    if sid and sid != \"default\":\n        return sid\n    if _session_isolate_enabled():\n        return default_process_session_id()\n    return None if sid == \"default\" else sid"
      },
      {
        "id": "packages/pipeline/session_isolation.py::_session_isolate_enabled",
        "loc": "packages/pipeline/session_isolation.py:382-387",
        "text": "def _session_isolate_enabled() -> bool:\n    return (os.environ.get(\"CTX_MCP_SESSION_ISOLATE\") or \"\").strip().lower() in {\n        \"1\",\n        \"true\",\n        \"yes\",\n    }"
      }
