        "text": "def _graph_degree(graph: AstTraceGraph, nodes: dict[str, TraceNode]) -> dict[str, int]:\n    deg: dict[str, int] = {nid: 0 for nid in nodes}\n    for nid in nodes:\n        try:\n            deg[nid] = len(list(graph.neighbors(nid, directed=True)))\n        except Exception:  # noqa: BLE001\n            deg[nid] = 0\n    return deg"
