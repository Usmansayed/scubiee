# Scubiee needs no API keys or environment variables to run.
# Everything below is optional; uncomment a line only to override the default.
# Never commit a real .env file (it is git-ignored).

# Engine state directory (default: ~/.scubiee)
# CTX_HOME=/path/to/scubiee-home

# Local engine URL (default: http://127.0.0.1:8765)
# CTX_ENGINE_URL=http://127.0.0.1:8765

# Changed-file count before a sync asks for --confirm (default: 400)
# CTX_INCREMENTAL_MAX_TOUCH=400

# Disable pre-embed chunk compression (default: mix)
# CTX_COMPRESS=off

# Disable the engine watchdog
# CTX_WATCHDOG=0

# macOS: use the non-MLX embedding path
# CTX_MLX=0
