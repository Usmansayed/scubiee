{
  "description": "OOD v9 — 4 hard DISTRIBUTED multi-file expansion tests. Each case must span many files; seed alone is insufficient.",
  "hot_threshold": 0.45,
  "cases": [
    {
      "id": "d1",
      "family": "dist-checkout-graph",
      "prompt": "distributed checkout: cart validate, pricing catalog+tax, inventory reserve/stock/warehouse, billing charge+HTTP, shipping schedule+mailer — code lives in many packages",
      "seed": {"file": "app/checkout/begin.py", "symbol": "begin"},
      "must": [
        {"file": "app/checkout/begin.py", "symbol": "begin"},
        {"file": "app/cart/validate.py", "symbol": "validate"},
        {"file": "app/pricing/quote.py", "symbol": "quote"},
        {"file": "app/pricing/catalog.py", "symbol": "unit_price"},
        {"file": "app/tax/compute.py", "symbol": "compute"},
        {"file": "app/tax/rates.py", "symbol": "rate_for"},
        {"file": "app/inventory/reserve.py", "symbol": "reserve"},
        {"file": "app/inventory/stock.py", "symbol": "available"},
        {"file": "app/inventory/warehouse.py", "symbol": "levels"},
        {"file": "app/billing/invoices.py", "symbol": "charge"},
        {"file": "app/http/client.py", "symbol": "get"},
        {"file": "app/shipping/schedule.py", "symbol": "schedule"},
        {"file": "app/notify/mailer.py", "symbol": "send"}
      ],
      "should": [
        {"file": "app/config/database.py", "symbol": "connect"},
        {"file": "app/audit/record.py", "symbol": "record"}
      ],
      "must_not": [
        {"file": "app/middleware/auth.py", "symbol": "authenticate"},
        {"file": "app/oauth/refresh.py", "symbol": "refresh"},
        {"file": "app/webhooks/ingest.py", "symbol": "ingest"}
      ]
    },
    {
      "id": "d2",
      "family": "dist-auth-identity",
      "prompt": "identity stack across routes, middleware, jwt service, token utils, user repo, DB connect, security TTL — spread over many files",
      "seed": {"file": "app/routes/login.py", "symbol": "login"},
      "must": [
        {"file": "app/routes/login.py", "symbol": "login"},
        {"file": "app/middleware/auth.py", "symbol": "authenticate"},
        {"file": "app/middleware/auth.py", "symbol": "extract_bearer"},
        {"file": "app/services/jwt_service.py", "symbol": "JwtService.verify"},
        {"file": "app/utils/token.py", "symbol": "decode"},
        {"file": "app/repositories/user_repo.py", "symbol": "UserRepository.resolve"},
        {"file": "app/models/user.py", "symbol": "User.lookup"},
        {"file": "app/config/database.py", "symbol": "connect"}
      ],
      "should": [
        {"file": "app/config/security.py", "symbol": "TOKEN_TTL"}
      ],
      "must_not": [
        {"file": "app/utils/logger.py", "symbol": "log"},
        {"file": "app/analytics/tracker.py", "symbol": "track"},
        {"file": "app/billing/invoices.py", "symbol": "charge"}
      ]
    },
    {
      "id": "d3",
      "family": "dist-webhook-pay",
      "prompt": "partner webhook path across ingest verify parse route handlers billing audit http mailer — each hop a different file",
      "seed": {"file": "app/webhooks/ingest.py", "symbol": "ingest"},
      "must": [
        {"file": "app/webhooks/ingest.py", "symbol": "ingest"},
        {"file": "app/webhooks/verify_sig.py", "symbol": "verify_sig"},
        {"file": "app/webhooks/parse.py", "symbol": "parse"},
        {"file": "app/webhooks/route.py", "symbol": "route"},
        {"file": "app/webhooks/handlers.py", "symbol": "on_payment"},
        {"file": "app/billing/invoices.py", "symbol": "charge"},
        {"file": "app/audit/record.py", "symbol": "record"},
        {"file": "app/http/client.py", "symbol": "get"},
        {"file": "app/notify/mailer.py", "symbol": "send"},
        {"file": "app/audit/record.py", "symbol": "record"}
      ],
      "should": [
        {"file": "app/config/database.py", "symbol": "connect"},
        {"file": "app/config/security.py", "symbol": "TOKEN_TTL"}
      ],
      "must_not": [
        {"file": "app/routes/login.py", "symbol": "login"},
        {"file": "app/jobs/worker.py", "symbol": "run"},
        {"file": "app/checkout/begin.py", "symbol": "begin"}
      ]
    },
    {
      "id": "d4",
      "family": "dist-upload-search",
      "prompt": "upload crosses receive scan store cache memo index tokenize search — then mailer notify; files in uploads search cache notify",
      "seed": {"file": "app/uploads/receive.py", "symbol": "receive"},
      "must": [
        {"file": "app/uploads/receive.py", "symbol": "receive"},
        {"file": "app/uploads/scan.py", "symbol": "scan"},
        {"file": "app/uploads/store.py", "symbol": "store"},
        {"file": "app/cache/memo.py", "symbol": "put"},
        {"file": "app/uploads/index_file.py", "symbol": "index_file"},
        {"file": "app/search/tokenize.py", "symbol": "tokenize_q"},
        {"file": "app/notify/mailer.py", "symbol": "send"},
        {"file": "app/http/client.py", "symbol": "get"}
      ],
      "should": [],
      "must_not": [
        {"file": "app/middleware/auth.py", "symbol": "authenticate"},
        {"file": "app/billing/invoices.py", "symbol": "charge"},
        {"file": "app/webhooks/ingest.py", "symbol": "ingest"}
      ]
    }
  ]
}
